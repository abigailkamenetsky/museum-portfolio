# Which museum shell renders. `legacy` is the hand-built Blender/R3F hall and is
# the default; `marble` is the World Labs splat room. Marble stays opt-in until
# the exported assets exist and the room is approved.
VITE_MUSEUM_ENVIRONMENT=legacy

# Ships the development-only painting placement editor. Never set this in the
# production build: it is a build-time flag, not an auth mechanism.
VITE_ENABLE_MUSEUM_EDITOR=false
